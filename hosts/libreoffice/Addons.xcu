<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <!-- Tools > Add-Ons > LaTeX Equation... (always available) -->
    <node oor:name="AddonMenu">
      <node oor:name="org.lavatex.libreoffice.menu" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string"><value>service:org.lavatex.LibreOffice?equation</value></prop>
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">LaTeX Equation (LavaTeX)...</value></prop>
        <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument</value></prop>
        <prop oor:name="ImageIdentifier" oor:type="xs:string"><value>%origin%/icons/lavatex_16.png</value></prop>
      </node>
    </node>
    <!-- Insert > LaTeX Equation..., right after Insert > Image -->
    <node oor:name="OfficeMenuBarMerging">
      <node oor:name="org.lavatex.libreoffice.insert" oor:op="replace">
        <node oor:name="S1" oor:op="replace">
          <prop oor:name="MergePoint"><value>.uno:InsertMenu\.uno:InsertGraphic</value></prop>
          <prop oor:name="MergeCommand"><value>AddAfter</value></prop>
          <prop oor:name="MergeCommandParameter"><value/></prop>
          <prop oor:name="MergeFallback"><value>Ignore</value></prop>
          <prop oor:name="MergeContext"><value>com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument</value></prop>
          <node oor:name="MenuItems">
            <node oor:name="M1" oor:op="replace">
              <prop oor:name="URL"><value>service:org.lavatex.LibreOffice?equation</value></prop>
              <prop oor:name="Title"><value xml:lang="en-US">LaTeX Equation...</value></prop>
              <prop oor:name="Target"><value>_self</value></prop>
              <prop oor:name="Context"><value/></prop>
            </node>
          </node>
        </node>
      </node>
    </node>
    <!-- Standard toolbar button, right after Insert Image -->
    <node oor:name="OfficeToolbarMerging">
      <node oor:name="org.lavatex.libreoffice.toolbar" oor:op="replace">
        <node oor:name="T1" oor:op="replace">
          <prop oor:name="MergeToolBar"><value>standardbar</value></prop>
          <prop oor:name="MergePoint"><value>.uno:InsertGraphic</value></prop>
          <prop oor:name="MergeCommand"><value>AddAfter</value></prop>
          <prop oor:name="MergeCommandParameter"><value/></prop>
          <prop oor:name="MergeFallback"><value>AddLast</value></prop>
          <prop oor:name="MergeContext"><value>com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument</value></prop>
          <node oor:name="ToolBarItems">
            <node oor:name="B1" oor:op="replace">
              <prop oor:name="URL"><value>service:org.lavatex.LibreOffice?equation</value></prop>
              <prop oor:name="Title"><value xml:lang="en-US">LaTeX Equation (insert or edit)</value></prop>
              <prop oor:name="ImageIdentifier"><value>%origin%/icons/lavatex_26.png</value></prop>
              <prop oor:name="Target"><value>_self</value></prop>
              <prop oor:name="Context"><value/></prop>
            </node>
          </node>
        </node>
      </node>
    </node>
    <node oor:name="Images">
      <node oor:name="org.lavatex.libreoffice.image" oor:op="replace">
        <prop oor:name="URL"><value>service:org.lavatex.LibreOffice?equation</value></prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL"><value>%origin%/icons/lavatex_16.png</value></prop>
          <prop oor:name="ImageBigURL"><value>%origin%/icons/lavatex_26.png</value></prop>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
